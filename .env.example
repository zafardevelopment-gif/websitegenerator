# ── Phase 1 required ─────────────────────────────────────────────
# Copy the relevant vars into apps/admin/.env.local (and later apps/sites/.env.local).

# Supabase (Project Settings → API)
# ⚠ Never put real keys in this file — it is committed to git.
#   Real values live in apps/admin/.env.local (gitignored).


NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client


# 32-byte base64 key for encrypting API keys stored in aiwebsite_settings.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Domains
NEXT_PUBLIC_BASE_DOMAIN=aivexallp.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# ── Later phases (documented in docs/ARCHITECTURE.md §7) ─────────
# ANTHROPIC_API_KEY=            # Phase 6 (can also be set in Settings UI)
# GEMINI_API_KEY=               # Phase 6
# CLOUDINARY_CLOUD_NAME=        # Phase 8
# CLOUDINARY_API_KEY=           # Phase 8
# CLOUDINARY_API_SECRET=        # Phase 8
# RESEND_API_KEY=               # Phase 11
# RAZORPAY_KEY_ID=              # Phase 14
# RAZORPAY_KEY_SECRET=          # Phase 14
# RAZORPAY_WEBHOOK_SECRET=      # Phase 14
# VERCEL_API_TOKEN=             # Phase 14 (Vercel Domains API)
# VERCEL_PROJECT_ID_SITES=      # Phase 14 (apps/sites project id on Vercel)
# VERCEL_TEAM_ID=               # Phase 14 (only if the Vercel project is under a team)
# PAGESPEED_API_KEY=            # Phase 13
# CRON_SECRET=                  # Phase 12
# GOOGLE_PLACES_API_KEY=        # Phase 15 (can also be set in Settings UI) — pulls lead gallery photos
