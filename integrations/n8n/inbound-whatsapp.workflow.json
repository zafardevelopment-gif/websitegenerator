{
  "name": "AIVEXA — Inbound WhatsApp relay",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-cloud-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "WhatsApp Cloud API webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "notes": "Also handle Meta's GET verification handshake (hub.challenge) — enable in node settings.",
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{$json.body.entry[0].changes[0].value.messages}}",
              "rightValue": "",
              "operator": { "type": "array", "operation": "exists" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-message",
      "name": "Message or status?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const v = $json.body.entry[0].changes[0].value;\nconst msg = v.messages[0];\nreturn [{ json: {\n  from: msg.from,\n  body: msg.text ? msg.text.body : '',\n  provider_message_id: msg.id,\n  timestamp: new Date(Number(msg.timestamp) * 1000).toISOString(),\n} }];"
      },
      "id": "shape-message",
      "name": "Shape inbound message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "jsCode": "const v = $json.body.entry[0].changes[0].value;\nconst status = v.statuses[0];\nreturn [{ json: {\n  event: 'status',\n  provider_message_id: status.id,\n  status: status.status,\n} }];"
      },
      "id": "shape-status",
      "name": "Shape status callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst body = JSON.stringify($json);\nconst signature = crypto.createHmac('sha256', secret).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      },
      "id": "sign-payload",
      "name": "Sign payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ADMIN_BASE_URL}}/api/webhooks/whatsapp-inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Signature", "value": "={{$json.signature}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.body}}",
        "options": {}
      },
      "id": "relay-to-admin",
      "name": "POST whatsapp-inbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "WhatsApp Cloud API webhook": { "main": [[{ "node": "Message or status?", "type": "main", "index": 0 }]] },
    "Message or status?": {
      "main": [
        [{ "node": "Shape inbound message", "type": "main", "index": 0 }],
        [{ "node": "Shape status callback", "type": "main", "index": 0 }]
      ]
    },
    "Shape inbound message": { "main": [[{ "node": "Sign payload", "type": "main", "index": 0 }]] },
    "Shape status callback": { "main": [[{ "node": "Sign payload", "type": "main", "index": 0 }]] },
    "Sign payload": { "main": [[{ "node": "POST whatsapp-inbound", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "meta": {
    "description": "Starter workflow — open every node before enabling. See integrations/n8n/README.md."
  }
}
